{
	"schemaVersion": 1,
	"id": "tsrheang_xray",
	"version": "${version}",
	"name": "Tsrheang Xray",
	"description": "Configurable Xraying client that fits into Masa",
	"authors": [
		"Tsrheang Drin"
	],
	"contact": {
		"sources": "https://github.com/gheescoo/tsrh_xray"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/xray/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"tsrh.xraying.client.Xray"
		],
		"modmenu": [
			"tsrh.xraying.client.gui.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "xray.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "xray.client.indigo.mixins.json",
			"environment": "client"
		},
		{
			"config": "xray.client.sodium.mixins.json",
			"environment": "client"
		},
		{
			"config": "xray.client.lithium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"malilib": ">=0.27.9"
	},
	"suggests": {
		"fabric-api": ">=0.141.3",
		"sodium": ">=0.8.11",
		"lithium": ">=0.21.4",
		"modmenu": ">=17.0.0"
	}
}